# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# 凭据：任何位置的 .env 与主密钥都不入库
.env
**/.secrets/

# 运行态数据忽略；评测基准商品集必须随代码版本化。
data/*
!data/catalog-v1.jsonl
!data/catalog-v2.jsonl
!data/catalog-v3.jsonl

# 评测报告是每次跑测的产物，不入库；标注集（eval/*.jsonl）要入库。
eval/report-*.md
eval/recall-report-*.md
eval/category-recall-report-*.md

# 评测运行产物（日志、数据库、隔离索引等）仅本地留存。
/eval/verification/

# 依赖与构建缓存
node_modules/
.cache/
frontend/dist/
*.tsbuildinfo

# 本地工具与 IDE
.idea/
.vscode/

# 设计文档、改动记录与图解仅在本地维护。
/docs/

# 个人材料与本机运行记录：不入公开仓库
/.workbuddy/
/interview/
/logs/
/tmp_*.py
.research/

# 根目录下的临时文件不入库，只保留项目说明
/*.md
!/README.md
!/AGENTS.md
/*.html
/*.json
/*.xml
/*.png
/*.jpg
